    <flag energy="enable"/>
  </option>
  <worldbody>
    <light pos="0 -2 3" dir="0 1 -1" diffuse="0.9 0.9 0.9"/>
    <body name="link" pos="0 0 1.2">
      <joint name="pivot" type="hinge" axis="0 1 0" damping="0"/>
      <geom type="capsule" fromto="0 0 0 0 0 -1" size="0.03" mass="1"
            contype="0" conaffinity="0" rgba="0.22 0.42 0.60 1"/>
    </body>
  </worldbody>
</mujoco>
