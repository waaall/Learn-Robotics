<!-- Derived from experiments/mujoco_physics/models/drop_ball.xml in this repository. -->
<mujoco model="ball_plane_contact">
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast"
          solver="Newton" iterations="100" tolerance="1e-10" cone="elliptic">
    <flag energy="enable"/>
  </option>
  <default>
    <geom condim="3" friction="0.8 0.005 0.0001"
          solref="0.02 1" solimp="0.9 0.95 0.001"/>
  </default>
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="ground" type="plane" size="2 2 0.1" rgba="0.75 0.79 0.82 1"/>
    <body name="ball" pos="0 0 1">
      <freejoint/>
      <geom name="ball_geom" type="sphere" size="0.1" mass="1" rgba="0.22 0.42 0.60 1"/>
    </body>
  </worldbody>
</mujoco>
