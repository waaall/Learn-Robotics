  <description>One-joint kinematic ROS 2 integration demo, without dynamics or feedback control.</description>
  <maintainer email="maintainer@example.com">Learn Robotics</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
