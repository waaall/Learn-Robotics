<?xml version="1.0"?>
<robot name="one_joint_demo">
  <link name="base_link">
    <visual>
      <geometry><box size="0.2 0.2 0.1"/></geometry>
      <material name="base_blue"><color rgba="0.2 0.4 0.8 1"/></material>
    </visual>
  </link>
  <link name="arm_link">
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry><box size="0.05 0.05 0.5"/></geometry>
      <material name="arm_orange"><color rgba="0.9 0.5 0.1 1"/></material>
    </visual>
  </link>
  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/><child link="arm_link"/>
    <origin xyz="0 0 0.05"/><axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="5.0" velocity="1.0"/>
  </joint>
</robot>
